generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             Int              @id @default(autoincrement())
  username       String           @unique
  googleId       String           @unique
  avatarUrl      String?
  memberSince    DateTime         @default(now())
  description    String           @default("")
  spotifyPublic  Boolean          @default(false)
  posts          Post[]
  likes          PostLike[]
  spotifyAccount   SpotifyAccount?
  monthlySnapshots MonthlySnapshot[]
  weeklySnapshots  WeeklySnapshot[]
  aiAnalyses       AiAnalysis[]
}

model SpotifyAccount {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  spotifyId    String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MonthlySnapshot {
  id        Int      @id @default(autoincrement())
  userId    Int
  month     String   // "2026-03" (YYYY-MM)
  artists   String   // JSON: SnapshotArtist[]
  tracks    String   // JSON: SnapshotTrack[]
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
}

model WeeklySnapshot {
  id        Int      @id @default(autoincrement())
  userId    Int
  week      String   // "2026-W10"
  artists   String   // JSON: SnapshotArtist[]
  tracks    String   // JSON: SnapshotTrack[]
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, week])
}

model AiAnalysis {
  id        Int      @id @default(autoincrement())
  userId    Int
  period    String   // "weekly" or "monthly"
  key       String   // "2026-W10" or "2026-03"
  content   String   // AI-generated text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, key])
}

model Post {
  id        Int        @id @default(autoincrement())
  title     String
  content   String
  username  String
  timestamp DateTime   @default(now())
  likes     Int        @default(0)
  avatarUrl String
  album     String?
  author    User       @relation(fields: [username], references: [username])
  postLikes PostLike[]
}

model PostLike {
  postId Int
  userId Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}
